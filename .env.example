# ---------------------------------------------------------------------------
# Local development environment. Copy to `.env` and change the secrets.
#   cp .env.example .env
# Docker Compose reads this file via `env_file`.
# ---------------------------------------------------------------------------

# Secret used to sign session JWTs. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# MQTT broker credentials. The local Mosquitto config allows anonymous
# connections, but the API still sends these, so they must be non-empty.
MQTT_USER=backend
MQTT_PASS=dev-only-change-me

# MQTT broker address (use `mosquitto` inside docker compose, 127.0.0.1 locally).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# SQLite database file. Relative paths resolve against the working directory.
DB_PATH=server/data/telemetry.db

# Directory containing the built web UI (index.html + assets/).
STATIC_DIR=server/static

# Public base URL used when rendering QR pairing links.
PUBLIC_BASE_URL=http://localhost:8000

# Telemetry retention and device-online thresholds.
RETENTION_DAYS=90
OFFLINE_AFTER_SEC=90

# Backup retention for server/deploy/backup.sh (0 disables pruning). Separate
# from RETENTION_DAYS above, which controls telemetry, not database backups.
# BACKUP_RETENTION_DAYS=7
